# TravianZ Docker configuration
#
# Copy this file to .env before starting:
#   cp .env.example .env
#
# Replace every CHANGE_ME value with a strong unique password.

# Public HTTP port exposed by the TravianZ web container.
TRAVIANZ_HTTP_PORT=8810

# Optional canonical public URL, especially behind a reverse proxy.
# Example: https://travianz.example.org
TRAVIANZ_PUBLIC_URL=

# Host directory used for persistent runtime and MariaDB data.
# Relative paths are resolved from the directory containing compose.yaml.
TRAVIANZ_DATA_DIR=../data

# MariaDB initialization.
MARIADB_DATABASE=travian
MARIADB_USER=travianz
MARIADB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Optional phpMyAdmin port.
# phpMyAdmin is only started with:
#   docker compose --profile tools up -d
PHPMYADMIN_HTTP_PORT=8811
